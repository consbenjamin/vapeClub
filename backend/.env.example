# Base de datos
MONGODB_URI=mongodb://localhost:27017/vapeclub

# Servidor
PORT=5001

# Mercado Pago (credenciales de prueba: https://www.mercadopago.com.ar/developers)
# En producción: usar Access Token de producción (panel de desarrolladores).
MP_ACCESS_TOKEN=APP_USR-xxxx

# URL del frontend (para redirección success/failure/pending)
# En producción: URL pública del frontend, ej. https://vapeclub.vercel.app
FRONTEND_URL=http://localhost:3000

# JWT (auth)
# En producción: usar un secreto fuerte distinto al de desarrollo (mín. 32 caracteres aleatorios).
JWT_SECRET=tu_secreto_jwt

# Cloudinary (subida de imágenes)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
